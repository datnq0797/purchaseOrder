# Copy to backend/.env on the server, fill in APP_KEY and DB_* , then:
#   php artisan key:generate   (only if APP_KEY left blank)
#   php artisan migrate --seed --force

APP_NAME="Purchase Order Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://purchaseoder.shop

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Same origin as the SPA — CORS never triggers, but keep it correct.
FRONTEND_URL=https://purchaseoder.shop

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@purchaseoder.shop"
MAIL_FROM_NAME="${APP_NAME}"
